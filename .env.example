# Desarrollo local. Copia este archivo como .env antes de ejecutar Django.
# REQUERIDO: genera una clave local con el comando indicado en README.md.
DJANGO_SECRET_KEY=
# AJUSTA según el entorno; conserva True solo en desarrollo local.
DJANGO_DEBUG=True
# REQUERIDO al servir HTTP: hosts separados por comas; estos sirven a runserver.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# OPCIONAL en desarrollo local; en producción usa orígenes HTTPS completos.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Mantén estas opciones desactivadas mientras runserver use HTTP local.
DJANGO_HTTPS_ENABLED=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL_HEADER=False

# PostgreSQL local. Los cinco valores son REQUERIDOS antes de migrar.
# Reemplaza nombre, usuario y contraseña según tu instalación; no confirmes
# credenciales reales en este archivo de ejemplo.
DB_NAME=punto_aparte
DB_USER=punto_aparte_user
DB_PASSWORD=reemplaza-esto-localmente
DB_HOST=localhost
DB_PORT=5432
